backend/uploads/**
!backend/uploads/.gitkeep
*.webm
*.mp4
*.wav
*.mp3
*.ogg
*.mov
*.avi
*.pdf
*.docx
*.doc

# Build & Runtime artifacts
dist/
**/dist/
dist-ssr/
build/
**/build/

