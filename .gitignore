# Environment & Secret variables (NEVER commit secrets)
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
.pytest_cache/

# Node & Dependencies
node_modules/
**/node_modules/

# User Uploads & Media Files (NEVER commit user data)
uploads/
**/uploads/*
