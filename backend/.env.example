# InterviewX Backend — Environment Variables
# Copy this file to .env and fill in real values

# MongoDB (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adaptive-ai-interviewer?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adaptive-ai-interviewer?retryWrites=true&w=majority
LOCAL_MONGO_URI=mongodb://localhost:27017/adaptive-ai-interviewer

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI Service (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET_KEY=your_internal_service_secret_key
AI_SERVICE_TIMEOUT=60000
# LLM Configuration (OpenAI / Gemini / Configured Provider)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Upload Directory
UPLOAD_DIR=./uploads
