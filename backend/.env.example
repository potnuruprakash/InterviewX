# InterviewX Backend — Environment Variables
# Copy this file to .env and fill in real values

# MongoDB (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adaptive-ai-interviewer?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adaptive-ai-interviewer?retryWrites=true&w=majority
LOCAL_MONGO_URI=mongodb://localhost:27017/adaptive-ai-interviewer

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI Microservices Routing
# Core AI Service (SBERT text evaluation + Librosa audio analysis)
AI_SERVICE_URL=http://localhost:8000
# Video AI Service (YOLOv8 person detection + MediaPipe landmark analysis)
VIDEO_AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_SECRET_KEY=your_internal_service_secret_key
AI_SERVICE_TIMEOUT=60000
AI_SERVICE_TEXT_TIMEOUT=15000
AI_SERVICE_AUDIO_TIMEOUT=60000
VIDEO_AI_SERVICE_TIMEOUT=120000
# LLM Configuration (OpenAI / Gemini / Configured Provider)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Upload Directory
UPLOAD_DIR=./uploads

# Client & Deployment Configuration
FRONTEND_URL=http://localhost:5173
PORT=5000

# Performance & Free-Tier Optimization Flags
# AI Service video sampling (defaults: 1 FPS, max 60 frames, max 640px dimension)
VIDEO_FRAME_SAMPLE_FPS=1
VIDEO_MAX_FRAMES=60
VIDEO_MAX_FRAME_DIM=640
