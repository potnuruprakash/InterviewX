# InterviewX Backend — Environment Variables
# Copy this file to .env and fill in real values

# MongoDB
MONGODB_URI=mongodb://localhost:27017/interviewx

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI Service (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=60000
AI_SERVICE_SECRET_KEY=your_internal_ai_service_secret_key_here

# Server

PORT=5000
NODE_ENV=development

# CORS — frontend URL
FRONTEND_URL=http://localhost:5173

# LLM Provider Selection: 'openai' (default) or 'gemini'
LLM_PROVIDER=openai

# OpenAI API Integration (AI Assistant - Backend ONLY)
# Never expose keys to frontend or version control
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Integration (Alternative)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
