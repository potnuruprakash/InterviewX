# InterviewX AI Service — Environment Variables
# Copy this file to .env and fill in real values

# Service port
PORT=8000

# Runtime Mode: 'core' (SBERT & Audio), 'video' (YOLOv8 & MediaPipe), or 'full' (all models)
AI_SERVICE_MODE=core

# Max simultaneous media inferences per service instance (keeps RAM bounded on Render free tier)
MAX_CONCURRENT_INFERENCES=1

# Backend URL (for CORS allowlist)
BACKEND_URL=http://localhost:5000

# Internal service authentication secret key (must match backend)
AI_SERVICE_SECRET_KEY=your_internal_ai_service_secret_key_here

# SBERT model name (auto-downloaded on first use)
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# YOLOv8 model weights path (auto-downloaded if not present)
# Use "yolov8n.pt" (nano), "yolov8s.pt" (small), etc.
YOLO_MODEL_PATH=yolov8n.pt

# Video frame sampling rate (frames per second)
VIDEO_FRAME_SAMPLE_FPS=1

# Maximum width/height processed by the video AI pipeline (reduces CPU on Render)
VIDEO_MAX_DIMENSION=640

# CNN-LSTM model weights (Phase 15+ — leave empty if not trained)
AUDIO_MODEL_PATH=

# Environment
ENV=development
