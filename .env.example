# ============================================================
# Adaptive AI Personalized Multimodal Interview Intelligence System
# Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/adaptive-ai-interviewer
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/adaptive-ai-interviewer

# --- Clerk Authentication (Backend) ---
# Get from https://dashboard.clerk.com > API Keys
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY_HERE

# --- Server Config ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- File Upload ---
UPLOAD_DIR=./uploads

# --- AI Service (FastAPI) ---
AI_SERVICE_URL=http://localhost:8000

# --- LLM Provider (Phase 4+) ---
# Options: openai, gemini, groq
LLM_PROVIDER=openai
LLM_API_KEY=YOUR_LLM_API_KEY_HERE

# ============================================================
# FRONTEND (frontend/.env)
# ============================================================
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY_HERE
# VITE_API_URL=http://localhost:5000
